  "components": {
    "schemas": {
      "EvidencePolicyIn": {
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/EvidencePolicyMode",
            "default": "platform_rating"
          },
          "competition_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true,
            "title": "Competition Ids",
            "default": []
          }
        },
        "type": "object",
        "title": "EvidencePolicyIn"
      },
      "EvidencePolicyMode": {
        "type": "string",
        "enum": [
          "platform_rating",
          "allowlist"
        ],
        "title": "EvidencePolicyMode"
      },
      "FspCompetitionIn": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "discipline_id": {
            "type": "string",
            "title": "Discipline Id"
          },
          "participants": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Participants"
          },
          "difficulty": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Difficulty"
          },
          "official": {
            "type": "boolean",
            "title": "Official",
            "default": true
          },
          "skills": {
            "additionalProperties": {
              "type": "number",
              "maximum": 1.0,
              "minimum": 0.0
            },
            "type": "object",
            "title": "Skills"
          },
          "starts_on": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Starts On"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "discipline_id",
          "participants",
          "difficulty",
          "skills"
        ],
        "title": "FspCompetitionIn"
      },
      "FspDisciplineIn": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "FspDisciplineIn"
      },
      "FspParticipantIn": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "city": {
            "type": "string",
            "title": "City",
            "default": "Не указан"
          },
          "work_format": {
            "type": "string",
            "title": "Work Format",
            "default": "remote"
          },
          "desired_role": {
            "type": "string",
            "title": "Desired Role",
            "default": "ИТ-специалист"
          },
          "about": {
            "type": "string",
            "title": "About",
            "default": "Профиль импортирован из ФСП"
          },
          "stack": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Stack",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "FspParticipantIn"
      },
      "FspPayloadIn": {
        "properties": {
          "disciplines": {
            "items": {
              "$ref": "#/components/schemas/FspDisciplineIn"
            },
            "type": "array",
            "title": "Disciplines"
          },
          "participants": {
            "items": {
              "$ref": "#/components/schemas/FspParticipantIn"
            },
            "type": "array",
            "title": "Participants"
          },
          "competitions": {
            "items": {
              "$ref": "#/components/schemas/FspCompetitionIn"
            },
            "type": "array",
            "title": "Competitions"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/FspResultIn"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "disciplines",
          "participants",
          "competitions",
          "results"
        ],
        "title": "FspPayloadIn"
      },
      "FspResultIn": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "participant_id": {
            "type": "string",
            "title": "Participant Id"
          },
          "competition_id": {
            "type": "string",
            "title": "Competition Id"
          },
          "placement": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Placement"
          },
          "participants": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Participants"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "rank": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rank"
          }
        },
        "type": "object",
        "required": [
          "id",
          "participant_id",
          "competition_id",
          "placement",
          "participants",
          "role"
        ],
        "title": "FspResultIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OfferIn": {
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1,
            "title": "Candidate Id"
          },
          "vacancy_id": {
            "type": "string",
            "minLength": 1,
            "title": "Vacancy Id"
          },
          "salary_from": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Salary From"
          },
          "salary_to": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Salary To"
          },
          "message": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 10,
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "candidate_id",
          "vacancy_id",
          "salary_from",
          "salary_to",
          "message"
        ],
        "title": "OfferIn"
      },
      "RequirementIn": {
        "properties": {
          "skill_id": {
            "type": "string",
            "minLength": 1,
            "title": "Skill Id"
          },
          "level": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Level"
          },
          "criticality": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Criticality"
          }
        },
        "type": "object",
        "required": [
          "skill_id",
          "level",
          "criticality"
        ],
        "title": "RequirementIn"
      },
      "VacancyIn": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "title": "Id"
          },
          "employer": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Employer"
          },
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 3,
            "title": "Title"
          },
          "grade": {
            "type": "string",
            "maxLength": 30,
            "minLength": 2,
            "title": "Grade"
          },
          "work_format": {
            "type": "string",
            "enum": [
              "remote",
              "hybrid",
              "office"
            ],
            "title": "Work Format"
          },
          "salary_from": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Salary From"
          },
          "salary_to": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Salary To"
          },
          "requirements": {
            "items": {
              "$ref": "#/components/schemas/RequirementIn"
            },
            "type": "array",
            "minItems": 1,
            "title": "Requirements"
          },
          "evidence_policy": {
            "$ref": "#/components/schemas/EvidencePolicyIn",
            "default": {
              "mode": "platform_rating",
              "competition_ids": []
            }
          }
        },
        "type": "object",
        "required": [
          "id",
          "employer",
          "title",
          "grade",
          "work_format",
          "salary_from",
          "salary_to",
          "requirements"
        ],
        "title": "VacancyIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
