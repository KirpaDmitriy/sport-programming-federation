[Unit]
Description=Public GitHub activity analysis for candidate profiles
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fsp
Group=fsp
Environment=FSP_GITHUB_INSIGHTS_HOST=127.0.0.1
Environment=FSP_GITHUB_INSIGHTS_PORT=4030
# GITHUB_TOKEN: a read-only token for public data; without it the service reports missing_token.
EnvironmentFile=-/etc/fsp/github-insights.env
ExecStart=/opt/fsp/current/bin/fsp-github-insights
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=yes
MemoryMax=256M

[Install]
WantedBy=multi-user.target
