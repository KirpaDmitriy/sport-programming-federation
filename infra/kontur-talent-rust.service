[Unit]
Description=Vygotsky FSP career platform
After=network.target

[Service]
Type=simple
User=dima
Group=dima
WorkingDirectory=/opt/kontur-talent/current
Environment=HOST=0.0.0.0
Environment=PORT=8010
# DATABASE_URL comes from a host-managed env file; create a postgres role and
# database first (see infra/README.md#postgresql).
EnvironmentFile=-/etc/kontur-talent/db.env
Environment=FSP_AUTH_MODE=demo
Environment=FSP_DEMO_EMAIL_CODE=123456
Environment=FSP_ALLOWED_ORIGINS=http://93.77.179.211:8010,http://93-77-179-211.nip.io:8010
Environment=FSP_PUBLIC_WEB_URL=http://93.77.179.211:8010
Environment=GITHUB_CALLBACK_URL=http://93.77.179.211:8010/api/v1/integrations/github/callback
Environment=FSP_STATIC_DIR=/opt/kontur-talent/current/frontend
EnvironmentFile=-/etc/kontur-talent.env
ExecStart=/opt/kontur-talent/current/fsp-career-api
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/kontur-talent/current
ReadWritePaths=/var/lib/kontur-talent

[Install]
WantedBy=multi-user.target
