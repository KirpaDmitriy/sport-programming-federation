{
  "name": "fsp-frontend-handoff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.19 <25" },
  "scripts": {
    "mock:install": "npm --prefix mock-server ci",
    "mock": "npm --prefix mock-server start",
    "mock:test": "npm --prefix mock-server test",
