{
  "name": "fsp-frontend-handoff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "mock:install": "bun install --cwd mock-server --frozen-lockfile",
    "mock": "bun run --cwd mock-server start",
    "mock:test": "bun run --cwd mock-server test",
    "codegen": "bun run --cwd tools/contract-codegen generate",
    "codegen:check": "bun run --cwd tools/contract-codegen check",
    "reference:check": "bun run --cwd frontend-reference verify",
    "gallery": "bun scripts/build-gallery.mjs",
    "api:index": "bun scripts/build-api-index.mjs",
    "verify": "bun scripts/verify-package.mjs"
  },
  "packageManager": "bun@1.4.2"
}
